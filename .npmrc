# Cadeia de suprimentos (PROMPT_BACKEND_FALCAO.md, seção 5; spec 000, plano §2).
# Versões exatas no package.json.
save-exact=true
# Só instala versões publicadas há 7 dias ou mais.
min-release-age=7
# Scripts de instalação só dos pacotes listados em "allowScripts" (package.json da raiz);
# qualquer outro com script faz a instalação falhar.
strict-allow-scripts=true
# Recusa instalar com uma versão do Node fora de "engines".
engine-strict=true
