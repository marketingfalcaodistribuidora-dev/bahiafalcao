# Configuração da API do catálogo. Copie para api/.env (fora do Git) e ajuste.
# As variáveis da API são validadas no início (src/config/env.ts, T008): com algo inválido,
# a API não sobe. Nunca coloque senha ou chave real neste arquivo: o repositório é público.

# --- Ambiente -------------------------------------------------------------------------
# development | test | production (obrigatória).
NODE_ENV=development

# --- Banco local (só para o docker-compose.yml; a API não lê estas duas) --------------
# Usuário e senha do PostgreSQL local. A senha fica em branco de propósito: sem ela o
# banco não sobe. Use uma senha só sua, com letras e números (sem $, @ ou :).
POSTGRES_USUARIO=falcao
POSTGRES_SENHA=

# --- Conexão da API com o banco --------------------------------------------------------
# A mesma senha de cima no lugar de COLOQUE_A_SENHA (porta 5433, só em 127.0.0.1).
DATABASE_URL=postgresql://falcao:COLOQUE_A_SENHA@127.0.0.1:5433/falcao_dev

# --- Segurança das requisições (plano §3) ----------------------------------------------
# Origens exatas que podem chamar a API pelo navegador, separadas por vírgula.
# Só https://, sem barra no fim. http://localhost só com NODE_ENV=development.
CORS_ORIGENS=http://localhost:3000
# IPs ou faixas (CIDR) do proxy confiável, separados por vírgula. Vazio = não confia em
# ninguém e usa o IP da conexão. "true" e número de saltos são recusados.
TRUST_PROXY=
# Requisições por minuto por IP (de 10 a 10000).
LIMITE_GERAL_POR_MIN=300
# Só para a medição de performance: IPs fora do limite. Recusado em produção.
LIMITE_IGNORAR_IPS=
# Página /docs (OpenAPI). Em desenvolvimento já abre; em produção é recusada até a Fase 1.
DOCS_HABILITADO=false
# fatal | error | warn | info | debug
LOG_NIVEL=info
