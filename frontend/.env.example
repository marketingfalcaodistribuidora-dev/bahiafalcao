# Domínio definitivo do site (usado em canonical, sitemap, Open Graph e dados estruturados).
# Opcional. Em produção na Vercel, o padrão já é o domínio oficial (https://www.bahiafalcao.com.br,
# definido em src/lib/env.ts). Use só para sobrescrever, sem barra no final.
NEXT_PUBLIC_SITE_URL=

# Código de verificação do Google Search Console (opcional, só o valor do content)
GOOGLE_SITE_VERIFICATION=
