# Domínio definitivo do site (usado em canonical, sitemap, Open Graph e dados estruturados).
# Na Vercel: se ficar vazio, o site usa automaticamente o domínio de produção do projeto (*.vercel.app).
# Defina aqui quando tiver o domínio próprio, sem barra no final. Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Código de verificação do Google Search Console (opcional, só o valor do content)
GOOGLE_SITE_VERIFICATION=
