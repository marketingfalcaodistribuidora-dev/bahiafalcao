#!/bin/sh
# Portão do commit (spec 000, T004; CA7.4 e CA7.5). Ativado pelo script "prepare"
# (git config core.hooksPath .githooks).
# 1) gitleaks: nenhum segredo entra no repositório, que é público.
# 2) lint-staged: formatação e lint só nos arquivos preparados.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: BLOQUEADO. O gitleaks não está instalado."
  echo "  Instale com: winget install --id Gitleaks.Gitleaks --version 8.30.1 --exact"
  echo "  Depois feche e abra o terminal."
  exit 1
fi

if ! gitleaks git --staged --no-banner --redact; then
  echo ""
  echo "pre-commit: BLOQUEADO. Parece haver um segredo nos arquivos preparados (veja acima)."
  echo "  Tire o segredo do arquivo. Se a senha ou chave já foi usada de verdade, troque-a."
  exit 1
fi

# Uma tarefa por vez: a formatação e o lint mexem nos mesmos arquivos.
if ! npx --no-install lint-staged --concurrent false; then
  echo ""
  echo "pre-commit: BLOQUEADO. Corrija a formatação ou o lint acima."
  exit 1
fi
